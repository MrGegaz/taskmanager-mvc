@model IEnumerable<taskmanager_mvc.Models.Project>

@{
    ViewData["Title"] = "Aktivni projekti";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">Aktivni projekti</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Svi projekti</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Naziv</th>
                <th>Opis</th>
                <th>Datum početka</th>
                <th>Datum završetka</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Name</td>
                <td>@project.Description</td>
                <td>@project.StartDate.ToString("dd.MM.yyyy")</td>
                <td>@project.EndDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">Detalji</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
