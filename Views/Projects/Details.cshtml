@model taskmanager_mvc.Models.Project

@{
    ViewData["Title"] = "Detalji projekta";
}

<h2>@Model.Name</h2>
<hr/>

<dl class="row">
    <dt class="col-sm-3">Opis</dt>
    <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

    <dt class="col-sm-3">Datum početka</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Datum završetka</dt>
    <dd class="col-sm-9">@Model.EndDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Aktivan</span>
        }
        else
        {
            <span class="badge bg-secondary">Neaktivan</span>
        }
    </dd>
</dl>

<h5 class="mt-4">Taskovi (@Model.Tasks.Count)</h5>
<hr/>

@if (!Model.Tasks.Any())
{
    <p class="text-muted">Nema taskova za ovaj projekt.</p>
}
else
{
    <ul class="list-group">
        @foreach (var task in Model.Tasks)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @task.Title
                @if (task.IsCompleted)
                {
                    <span class="badge bg-success">Završeno</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">U tijeku</span>
                }
            </li>
        }
    </ul>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Uredi</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Povratak</a>
</div>