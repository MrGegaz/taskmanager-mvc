@model IEnumerable<taskmanager_mvc.Models.TaskItem>
@using taskmanager_mvc.Models

@{
    ViewData["Title"] = "Nezavršeni zadaci";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">Nezavršeni zadaci</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Svi zadaci</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Naslov</th>
                <th>Projekt</th>
                <th>Prioritet</th>
                <th>Rok</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Project?.Name</td>
                <td>
                    @Html.PriorityBadge(task.Priority)
                </td>
                <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Detalji</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>