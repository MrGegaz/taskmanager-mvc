@model IEnumerable<taskmanager_mvc.Models.TaskItem>

@{
    ViewData["Title"] = "Zadaci";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <h2 class="mb-0">Zadaci</h2>
        <input type="text"
               id="taskSearchInput"
               class="form-control"
               placeholder="Pretraživanje po nazivu..." />
    </div>
    <div>
        <a asp-action="Pending" class="btn btn-outline-secondary me-2">Nezavršeni</a>
        <a asp-action="Create" class="btn btn-success">Novi zadatak</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
        <tr>
            <th>Naslov</th>
            <th>Projekt</th>
            <th>Prioritet</th>
            <th>Rok</th>
            <th>Status</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Project?.Name</td>
                <td>
                    @Html.PriorityBadge(task.Priority)
                </td>
                <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (task.IsCompleted)
                    {
                        <span class="badge bg-success">Završeno</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">U tijeku</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-secondary">Uredi</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('taskSearchInput').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
