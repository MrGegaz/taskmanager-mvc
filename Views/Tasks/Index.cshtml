@model IEnumerable<taskmanager_mvc.Models.TaskItem>
@using taskmanager_mvc.Models

@{
    ViewData["Title"] = "Zadaci";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">Zadaci</h2>
    <a asp-action="Create" class="btn btn-primary">Novi zadatak</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Naslov</th>
                <th>Projekt</th>
                <th>Prioritet</th>
                <th>Rok</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Project?.Name</td>
                <td>
                    @switch (task.Priority)
                    {
                        case Priority.Visok:
                            <span class="badge bg-danger">Visok</span>
                            break;
                        case Priority.Normalan:
                            <span class="badge bg-warning text-dark">Normalan</span>
                            break;
                        case Priority.Nizak:
                            <span class="badge bg-success">Nizak</span>
                            break;
                    }
                </td>
                <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (task.IsCompleted)
                    {
                        <span class="badge bg-success">Završeno</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">U tijeku</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-secondary">Uredi</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>