@model IEnumerable<taskmanager_mvc.Models.TaskItem>
@using taskmanager_mvc.Models

@{
    ViewData["Title"] = "Pretraga zadataka";
}

<h2>Pretraga zadataka</h2>
<hr/>

<form asp-action="Search" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="query" value="@Context.Request.Query["query"]" class="form-control" placeholder="Pretraži po naslovu..."/>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Pretraži</button>
    </div>
</form>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Naslov</th>
                    <th>Projekt</th>
                    <th>Prioritet</th>
                    <th>Rok</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>@task.Project?.Name</td>
                    <td>
                        @switch (task.Priority)
                        {
                            case Priority.Visok:
                                <span class="badge bg-danger">Visok</span>
                                break;
                            case Priority.Normalan:
                                <span class="badge bg-warning text-dark">Normalan</span>
                                break;
                            case Priority.Nizak:
                                <span class="badge bg-success">Nizak</span>
                                break;
                        }
                    </td>
                    <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Detalji</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else if (Context.Request.Query.ContainsKey("query"))
{
    <p class="text-muted">Nema rezultata za traženi pojam.</p>
}